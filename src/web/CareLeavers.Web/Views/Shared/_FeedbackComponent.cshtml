@using CareLeavers.Web.Contentful
@using CareLeavers.Web.Configuration
@using Microsoft.Extensions.Options

@model CareLeavers.Web.Models.ViewModels.FeedbackViewModel
@inject IContentService ContentService
@{
    if (!(Model.Page.ShowQuickFeedback ?? false))
    {
        return;
    }

    var showFeedback = Model.Page.ShowQuickFeedback ?? false;

}
@if (showFeedback)
{
    <section class="dfe-section">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="gem-c-feedback gem-c-feedback__prompt" tabindex="-1">
                    <div class="gem-c-feedback__prompt-content">
                        <div class="gem-c-feedback__prompt-questions" id="feedbackQuestion">
                            <div class="gem-c-feedback__prompt-question-answer">
                                <h2 class="gem-c-feedback__prompt-question">Is this page useful?</h2>
                                <ul class="gem-c-feedback__option-list">
                                    <li class="gem-c-feedback__option-list-item">
                                        <button class="govuk-button gem-c-feedback__prompt-link" id="yesFeedback">
                                            Yes <span class="govuk-visually-hidden">this page is useful</span>
                                        </button>
                                    </li>
                                    <li class="gem-c-feedback__option-list-item">
                                        <button class="govuk-button gem-c-feedback__prompt-link" aria-controls="page-is-not-useful" id="noFeedback">
                                            No <span class="govuk-visually-hidden">this page is not useful</span>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="gem-c-feedback__prompt-questions gem-c-feedback__prompt-success" hidden="" role="alert" id="successYesfeedback">
                            Thank you for your feedback
                        </div>

                        <div class="gem-c-feedback__prompt-questions" hidden="" role="alert" id="successNofeedback">
                            <h2 class="gem-c-feedback__form-heading">Help us improve this website</h2>
                            <p class="gem-c-feedback__form-paragraph">
                            To help us improve this website, we’d like to know more about your visit today.
                            <a href='@Model.FeedbackUrl' class="govuk-link" target="_blank" rel="noopener noreferrer external">Please fill in this survey (opens in a new tab<noscript> and requires JavaScript</noscript>)</a>.
                            </p> 
                            <button class="govuk-button gem-c-button--secondary-quiet" aria-controls="page-is-not-useful" id="cancelButton">Cancel</button>
                        </div>
                        
                        
                        <div class="gem-c-feedback__prompt-questions gem-c-feedback__prompt-questions--something-is-wrong" id="ReportProblem">
                            <button class="govuk-button gem-c-feedback__prompt-link" aria-controls="something-is-wrong" id="problemButton">
                                Help us to improve this website by providing feedback.
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
   

    <script asp-add-nonce="true">
        (function() {
            var yesfeedbackButton = document.querySelector("#yesFeedback");

            const feedbackQuestionDiv = document.querySelector('#feedbackQuestion');
            const reportProblemDiv = document.querySelector('#ReportProblem');
            const successYesDiv = document.querySelector('#successYesfeedback');
            const successNoDiv = document.querySelector('#successNofeedback');

      
            yesfeedbackButton.addEventListener("click", function(event) {              
                    feedbackQuestionDiv.toggleAttribute('hidden');
                    reportProblemDiv.toggleAttribute('hidden');
                    successYesfeedback.toggleAttribute('hidden');

            }, false);

            var nofeedbackButton = document.querySelector("#noFeedback");
            nofeedbackButton.addEventListener("click", function(event) {
                    feedbackQuestionDiv.toggleAttribute('hidden');
                    reportProblemDiv.toggleAttribute('hidden');
                    successNoDiv.toggleAttribute('hidden');
            }, false);

            var problemButton = document.querySelector("#problemButton");
            problemButton.addEventListener("click", function(event) {
                window.location.href = '@Model.FeedbackUrl';
            }, false);

            var cancelButton = document.querySelector("#cancelButton");
            cancelButton.addEventListener("click", function(event) {
                 feedbackQuestionDiv.toggleAttribute('hidden');
                 reportProblemDiv.toggleAttribute('hidden');
                 successNoDiv.toggleAttribute('hidden');
            }, false);
        })();
    </script>
}